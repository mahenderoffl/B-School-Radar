# Local dev only — used by the Prisma CLI (migrate/studio) against the local file.
# The app itself falls back to this same file automatically; you don't need to set
# anything else to run locally.
DATABASE_URL="file:./dev.db"

# Production (Vercel) — set these two in the Vercel project's environment variables
# instead of DATABASE_URL. See README.md "Deploying to Vercel" for how to get them.
# TURSO_DATABASE_URL="libsql://<your-db>.turso.io"
# TURSO_AUTH_TOKEN="..."
