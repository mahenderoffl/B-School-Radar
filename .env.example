# Local dev and production both use the same Postgres database (Prisma Postgres,
# created via Vercel's Storage tab / Marketplace integration). Copy the connection
# string it gives you into .env for local dev — Vercel injects the same variable
# into your deployed project automatically once the database is connected to it.
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."
